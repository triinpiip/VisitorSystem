{
  "info": {
    "name": "Visitor System API",
    "description": "Postman collection for Visitor System full-stack project.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\",\n  \"role\": \"administraator\",\n  \"email\": \"admin@example.com\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.collectionVariables.set('token', json.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Users / Profile",
      "item": [
        {
          "name": "My profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/me"
          }
        },
        {
          "name": "Employees",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/employees"
          }
        },
        {
          "name": "Admin only",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin-only"
          }
        }
      ]
    },
    {
      "name": "Guests",
      "item": [
        {
          "name": "List guests",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/guests"
          }
        },
        {
          "name": "Create guest",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/guests",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Mari\",\n  \"last_name\": \"Mets\",\n  \"personal_id\": \"49001010000\",\n  \"company\": \"Example O\\u00dc\"\n}"
            }
          }
        },
        {
          "name": "Delete guest",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/guests/1"
          }
        }
      ]
    },
    {
      "name": "Cards",
      "item": [
        {
          "name": "List cards",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/cards"
          }
        },
        {
          "name": "Assign card to guest",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/cards/1/assign-guest",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"guest_id\": 1,\n  \"purpose\": \"Kohtumine\"\n}"
            }
          }
        },
        {
          "name": "Free card",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/cards/1/free"
          }
        }
      ]
    },
    {
      "name": "Visits",
      "item": [
        {
          "name": "List visits",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/visits"
          }
        },
        {
          "name": "My visits",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/my-visits"
          }
        },
        {
          "name": "Create visit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/visits",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"guest_id\": 1,\n  \"employee_id\": 1,\n  \"access_card_id\": 1,\n  \"department_id\": 1,\n  \"purpose\": \"Kohtumine\",\n  \"note\": \"Test\"\n}"
            }
          }
        },
        {
          "name": "Finish visit",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/visits/1/finish"
          }
        },
        {
          "name": "Delete visit",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/visits/1"
          }
        }
      ]
    },
    {
      "name": "Departments",
      "item": [
        {
          "name": "List departments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/departments"
          }
        }
      ]
    }
  ]
}