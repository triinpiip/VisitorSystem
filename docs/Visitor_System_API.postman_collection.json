{
  "info": {
    "name": "Visitor System API",
    "description": "Postman collection for Visitor System backend routes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "guestId",
      "value": "1"
    },
    {
      "key": "visitId",
      "value": "1"
    },
    {
      "key": "cardId",
      "value": "1"
    },
    {
      "key": "employeeId",
      "value": "1"
    },
    {
      "key": "departmentId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "00 General",
      "item": [
        {
          "name": "API health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/"
          }
        }
      ]
    },
    {
      "name": "01 Auth",
      "item": [
        {
          "name": "Register admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin2\",\n  \"email\": \"admin@example.com\",\n  \"role\": \"administraator\",\n  \"password\": \"Admin123\",\n  \"confirmPassword\": \"Admin123\"\n}"
            }
          }
        },
        {
          "name": "Login admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.collectionVariables.set('token', json.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin2\",\n  \"password\": \"Admin123\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "02 Profile",
      "item": [
        {
          "name": "Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/profile"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/me"
          }
        },
        {
          "name": "Admin only",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin-only"
          }
        }
      ]
    },
    {
      "name": "03 Guests",
      "item": [
        {
          "name": "List guests",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/guests"
          }
        },
        {
          "name": "Create guest",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) {",
                  "  pm.collectionVariables.set('guestId', json.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/guests",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Mari\",\n  \"last_name\": \"Mets\",\n  \"personal_id\": \"49001010000\",\n  \"company\": \"Example OÜ\"\n}"
            }
          }
        },
        {
          "name": "Delete guest",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/guests/{{guestId}}"
          }
        }
      ]
    },
    {
      "name": "04 Employees and Departments",
      "item": [
        {
          "name": "List employees",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/employees"
          }
        },
        {
          "name": "List departments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/departments"
          }
        }
      ]
    },
    {
      "name": "05 Cards",
      "item": [
        {
          "name": "List cards",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/cards"
          }
        },
        {
          "name": "Assign card to guest",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/cards/{{cardId}}/assign-guest",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"guest_id\": 1,\n  \"purpose\": \"Kohtumine\"\n}"
            }
          }
        },
        {
          "name": "Free card",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/cards/{{cardId}}/free"
          }
        }
      ]
    },
    {
      "name": "06 Visits",
      "item": [
        {
          "name": "List visits",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/visits"
          }
        },
        {
          "name": "My visits",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/my-visits"
          }
        },
        {
          "name": "Create visit",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) {",
                  "  pm.collectionVariables.set('visitId', json.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/visits",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"guest_id\": 1,\n  \"employee_id\": 1,\n  \"access_card_id\": 1,\n  \"department_id\": 1,\n  \"purpose\": \"Kohtumine\",\n  \"note\": \"Testkülastus\"\n}"
            }
          }
        },
        {
          "name": "Finish visit",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/visits/{{visitId}}/finish"
          }
        },
        {
          "name": "Delete visit",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/visits/{{visitId}}"
          }
        }
      ]
    }
  ]
}